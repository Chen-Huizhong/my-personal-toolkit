# ============================================
# Ghostty Terminal - Complete Configuration
# ============================================

# --- Typography ---
font-family = "Ping Fang SC"
font-size = 15
font-thicken = true
font-feature = -liga
font-feature = -calt
adjust-cell-height = 6%

# --- Theme and Colors ---
theme = iTerm2 Default

# --- Window and Appearance ---
window-colorspace = display-p3
window-padding-x = 1
window-padding-y = 1
window-padding-color = extend
window-padding-balance = true
window-step-resize = false
background-opacity = 1
background-blur = true
macos-titlebar-style = transparent
window-save-state = always
window-width = 100
window-height = 24
window-theme = auto
window-vsync = true
bold-is-bright = true

# --- Cursor ---
cursor-style = block
cursor-style-blink = true
cursor-invert-fg-bg = false
cursor-opacity = 1

# --- Mouse ---
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2
copy-on-select = clipboard

# --- Quick Terminal (Quake-style dropdown) ---
quick-terminal-position = bottom
quick-terminal-screen = main
quick-terminal-autohide = true
quick-terminal-size = 50%
quick-terminal-animation-duration = 0.15

# --- Close behavior ---
confirm-close-surface = false

# --- MacOS ---
macos-auto-secure-input = true
macos-secure-input-indication = true
macos-titlebar-style = tabs
macos-option-as-alt = true
macos-icon             = custom-style
macos-icon-frame       = plastic
macos-icon-ghost-color = #ebdbb2
macos-icon-screen-color = #1d2021

# --- Security ---
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

# --- Shell Integration ---
term = "xterm-256color"

# --- Keybindings ---
# Tabs
keybind = super+t=new_tab
keybind = super+shift+left=previous_tab
keybind = super+shift+right=next_tab
keybind = super+w=close_surface

# Splits
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+alt+left=goto_split:left
keybind = super+alt+right=goto_split:right
keybind = super+alt+up=goto_split:top
keybind = super+alt+down=goto_split:bottom

# Font size
keybind = super+plus=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+zero=reset_font_size

# Quick terminal global hotkey
keybind = global:super+grave_accent=toggle_quick_terminal

# Splits management
keybind = super+shift+e=equalize_splits
keybind = super+shift+f=toggle_split_zoom

# Reload config
keybind = super+r=reload_config

# Full screen
keybind = super+f=toggle_fullscreen

# tmux style
keybind = super+b>x=close_surface
keybind = super+b>c=new_tab
keybind = super+b>n=new_window
keybind = super+b>f=toggle_fullscreen

# tab navigation
keybind = super+b>1=goto_tab:1
keybind = super+b>2=goto_tab:2
keybind = super+b>3=goto_tab:3
keybind = super+b>4=goto_tab:4
keybind = super+b>5=goto_tab:5
keybind = super+b>6=goto_tab:6
keybind = super+b>7=goto_tab:7
keybind = super+b>8=goto_tab:8
keybind = super+b>9=goto_tab:9

# tab split
keybind = super+b>\=new_split:right
keybind = super+b>-=new_split:down
keybind = super+b>e=equalize_splits
keybind = super+b>z=toggle_split_zoom

# split navigation
keybind = super+b>h=goto_split:left
keybind = super+b>j=goto_split:bottom
keybind = super+b>k=goto_split:top
keybind = super+b>l=goto_split:right
keybind = super+b>left=goto_split:left
keybind = super+b>down=goto_split:bottom
keybind = super+b>up=goto_split:top
keybind = super+b>right=goto_split:right

# --- Performance ---
scrollback-limit = 25000

quit-after-last-window-closed = true

auto-update = download
auto-update-channel = stable
link-url = true

